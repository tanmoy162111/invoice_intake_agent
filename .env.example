# Copy to .env and adjust. Never commit .env. No real secrets in this file.

# --- Host ports (change if these are taken on your machine) ---
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432

# --- Database ---
POSTGRES_PASSWORD=intake
# Used when running the API outside Docker (make dev-api). Compose sets its own.
DATABASE_URL=postgresql+psycopg://intake:intake@localhost:5432/intake
# Read-only role for the Postgres MCP server used by Claude Code (.mcp.json)
DATABASE_URL_READONLY=

# --- API ---
# Bearer token for every endpoint except /health (interim until login in M8).
# `make dev` / `make seed` generate one here if empty. Send it as: Authorization: Bearer <token>
API_TOKEN=
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=./storage

# --- Web ---
# Where the web server reaches the API (Compose overrides this to http://api:8000)
API_URL=http://localhost:8000

# --- Extraction (M3) ---
# Which backend reads invoices: anthropic (default) or ollama (local, DEMO ONLY, no data leaves your
# machine; it reads invoices worse than Claude, so its numbers say nothing about the Claude build).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# For ollama: set EXTRACTION_MODEL to a vision model you have pulled (see `ollama list`). Inside
# Docker use http://host.docker.internal:11434; invoice pages are sent to whatever URL you set here.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192
EXTRACTION_MODEL=claude-sonnet-5
# Daily model spend cap in USD (whole or decimal). Extraction pauses, visibly, when reached. 0 pauses all.
DAILY_SPEND_CAP_USD=5

# Fernet key for bank-detail encryption. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_ENCRYPTION_KEY=

# --- Ingestion limits (playbook §6.1) ---
MAX_UPLOAD_BYTES=15728640
MAX_PAGES=10
RENDER_DPI=200

# --- Job queue ---
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_S=10
JOB_BACKOFF_CAP_S=600
JOB_VISIBILITY_TIMEOUT_S=300
WORKER_POLL_INTERVAL_S=2
# LOG_LEVEL=INFO  (DEBUG can log document content; never use it with real data)
